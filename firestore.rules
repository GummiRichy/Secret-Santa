rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Santa Rounds: anyone signed in (the app signs everyone in anonymously)
    // can read and write room data. Matches, Elf Mail, and private keys are
    // encrypted in the app, so even you can't read them in the console.
    // The date stops all access after the season; change it to keep playing.
    match /rooms/{room}/{document=**} {
      allow read, write: if request.auth != null
                         && request.time < timestamp.date(2027, 3, 1);
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
